# No credentials. PostgreSQL remains opt-in; do not start without separate connection approval.
DB_DRIVER=postgres
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLROOTCERT=
PG_POOL_MAX=5
# Historical timezone must be reviewed before selecting either value.
PG_TIME_ZONE=
TZ=
# Keep unset pending review of whole-franc interest, schedule cents and closing tolerance.
ADELE_PG_FINANCIAL_POLICY=
# Existing nondeterministic collation needs a reviewed PostgreSQL search strategy.

# Do not set until ICU equality/search vectors pass on the actual PostgreSQL version.
ADELE_PG_SEARCH_REVIEWED=

# Integrated Railway uses railway.env.example and npm run start:railway.
# PG_CA_CERT supplies PEM; startup creates PGSSLROOTCERT automatically.
# This new empty deployment uses explicit matching UTC values.
