# Functional controlled testing only, distinct from the unchanged synthetic preview.
# Build settings, not secrets:
VITE_ADELE_PREVIEW_ONLY=false
VITE_API_URL=
# Pages Functions runtime variables:
API_MODE=railway-postgres
API_STAGE=postgres-restricted
API_ALLOWED_ORIGIN=https://<exact-protected-pages-origin>
API_UPSTREAM=https://<exact-railway-service>.up.railway.app
# Runtime secret, identical to Railway's value; never set through VITE_*:
API_PROXY_SECRET=<private-matching-proxy-secret>
# No database credentials, local runtime flags or service bindings in Pages.
