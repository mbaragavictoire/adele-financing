# Non-secret design template. No upstream credentials, real data or external service.
API_MODE=synthetic
VITE_ADELE_PREVIEW_ONLY=true
VITE_API_URL=
# Railway forwarding is deliberately NOT enabled here.
# A separately approved synthetic backend additionally needs API_STAGE=synthetic-sandbox,
