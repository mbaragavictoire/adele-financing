# Documentation only. Do not put secrets in source or VITE_* variables.
# These fail-closed defaults are also set in wrangler.workers.toml.
ADELE_WORKERS_API_ENABLED=false
ADELE_WORKERS_AUTH_CPU_REVIEWED=false
API_ALLOWED_ORIGIN=https://<approved-protected-hostname>
ADELE_WORKERS_DATABASE_REVIEWED=
# Only after a separate remote configuration audit, the accepted review value is:
# ADELE_WORKERS_DATABASE_REVIEWED=verify-full-no-cache
# HYPERDRIVE is a managed binding, NOT a plain-text variable or source connection URL.
# Its private origin credentials must use existing adele_railway with no extra grants.
# Do not supply DATABASE_URL, PGPASSWORD, PG_CA_CERT, PGSSLROOTCERT, API_UPSTREAM,
# API_PROXY_SECRET or ADELE_PG_FINANCIAL_POLICY to this Worker.

# PASSWORD_CPU is a private SQLite-backed Durable Object binding for bcrypt compute only.
# No application data or password is persisted there. Its new namespace needs future approval.
