# Documentation only: configure actual values privately in Railway Variables.
# Never copy credentials into this file. All placeholders below are nonfunctional.
NODE_ENV=production
DB_DRIVER=postgres
ADELE_DEPLOYMENT_MODE=postgres-restricted
PGHOST=<exact-session-pooler-host>
PGPORT=5432
PGDATABASE=postgres
PGUSER=adele_railway.<project-reference>
PGPASSWORD=<private-existing-role-password>
# Complete PEM CA bundle with actual line breaks, not literal backslash-n.
PG_CA_CERT=<private-runtime-variable-containing-public-CA-PEM>
PGSSLMODE=verify-full
PG_POOL_MAX=5
TZ=UTC
PG_TIME_ZONE=UTC
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
API_ALLOWED_ORIGIN=https://<exact-protected-pages-origin>
CORS_ORIGINS=https://<same-exact-protected-pages-origin>
API_PROXY_SECRET=<new-random-32-byte-base64url-value-entered-privately>
# No DATABASE_URL, ADELE_PG_FINANCIAL_POLICY, ADELE_PG_SEARCH_REVIEWED,
# ADELE_PROXY_SANDBOX_ONLY, DB_HOST/DB_NAME/DB_USER/DB_PASSWORD, or seed credentials.
# PGSSLROOTCERT is assigned automatically by start:railway; do not set it manually.
# PORT is supplied by Railway. Proxy hop counts are not trusted in this mode.
